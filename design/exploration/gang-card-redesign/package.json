{
  "name": "gyrinx-gang-card-redesign",
  "private": true,
  "type": "module",
  "scripts": {
    "build:styles": "tailwindcss --input src/theme.css --output public/theme.css --minify && node build-shadow-theme.mjs",
    "build": "npm run build:styles && vite build",
    "start": "vite --host 127.0.0.1 --port 8768 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 8768 --strictPort",
    "check": "node check.mjs",
    "format:check": "prettier --check src/*.{js,jsx,css} *.mjs *.json *.html"
  },
  "dependencies": {
    "cropperjs": "1.6.2",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "playwright": "1.64.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.0",
    "vite": "7.3.7"
  }
}
